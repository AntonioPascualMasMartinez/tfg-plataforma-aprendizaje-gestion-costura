# ==========================================
# Configuración del Servidor
# ==========================================
PORT=3000
NODE_ENV=development

# ==========================================
# Base de Datos (MongoDB Atlas)
# ==========================================
MONGO_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ==========================================
# Autenticación y Seguridad (JWT & OAuth)
# ==========================================
JWT_ACCESS_SECRET=sustituir_por_secreto_seguro_access
JWT_REFRESH_SECRET=sustituir_por_secreto_seguro_refresh
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=sustituir_por_client_id_de_google_cloud

# ==========================================
# Almacenamiento en la Nube (Cloudinary)
# ==========================================
CLOUDINARY_CLOUD_NAME=sustituir_por_cloud_name
CLOUDINARY_API_KEY=sustituir_por_api_key
CLOUDINARY_API_SECRET=sustituir_por_api_secret

# ==========================================
# Servicio de Correo (Nodemailer / SMTP)
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=correo_soporte@dominio.com
SMTP_PASS=contrasena_de_aplicacion_generada
FRONTEND_URL=http://localhost:4200